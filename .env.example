# StudioSpace Frontend — copy this file to .env.local and fill in your values

# Base URL of the StudioSpace Express API (see ../studiospace-backend)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth Web client ID (Google Cloud Console → APIs & Services → Credentials)
# Leave empty to run in demo mode (the Google button signs you in without verification).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: imgbb API key used by the "upload image" helper on studio forms
NEXT_PUBLIC_IMGBB_API_KEY=
